# Ubari Espaço de Psicologia — variáveis de ambiente
# Copie para .env.local e preencha

NEXT_PUBLIC_SITE_URL=https://ubari.com.br
NEXT_PUBLIC_GTM_ID=

# Webhook Kommo CRM (leads do formulário)
KOMMO_WEBHOOK_URL=

# Fallback de e-mail se o Kommo falhar
LEAD_EMAIL_WEBHOOK_URL=
LEAD_EMAIL_TO=contato@ubari.com.br

# Meta Conversions API (via GTM server / CAPI)
META_CAPI_ENABLED=false
